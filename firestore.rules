rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Analytics tracking collections accessible for public logging
    match /analytics_clicks/{document=**} {
      allow read, write: if true;
    }
    match /analytics_summary/{document=**} {
      allow read, write: if true;
    }
    match /analytics_items/{document=**} {
      allow read, write: if true;
    }

    // Default content collections: read public, write admin-only
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}